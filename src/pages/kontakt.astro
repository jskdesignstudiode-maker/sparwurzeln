---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../data/site';
---

<Base title="Kontakt" description="So erreichen Sie die Redaktion von Sparwurzeln per E-Mail.">
  <Breadcrumb items={[{ name: 'Startseite', href: '/' }, { name: 'Kontakt' }]} />
  <section class="section">
    <div class="container prose">
      <h1>Kontakt</h1>
      <p>
        Fragen, Hinweise oder Korrekturen zu unseren Ratgebern erreichen uns am einfachsten per
        E-Mail:
      </p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p>Wir antworten, sobald es uns möglich ist.</p>
    </div>
  </section>
</Base>
