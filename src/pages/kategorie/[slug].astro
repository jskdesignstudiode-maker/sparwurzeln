---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import { categories, type Category } from '../../data/categories';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

interface Props {
  category: Category;
}
const { category } = Astro.props;
const others = categories.filter((c) => c.slug !== category.slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: category.title,
  description: category.metaDescription,
  inLanguage: 'de-DE',
};
---

<Base title={category.title} description={category.metaDescription} jsonLd={jsonLd}>
  <Breadcrumb
    items={[
      { name: 'Startseite', href: '/' },
      { name: category.title },
    ]}
  />

  <section class="section cat-head">
    <div class="container">
      <Icon name={category.icon} />
      <h1>{category.title}</h1>
      <p class="lead">{category.description}</p>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="unterthemen">
    <div class="container">
      <h2 id="unterthemen">Themen in diesem Bereich</h2>
      <ul class="tag-list">
        {category.subcategories.map((s) => <li>{s.title}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="ratgeber">
    <div class="container">
      <h2 id="ratgeber">Ratgeber</h2>
      <div class="notice">
        <p>
          Die ersten Ratgeber dieses Bereichs sind in Arbeit und werden vor der Veröffentlichung
          geprüft. Sobald sie erscheinen, finden Sie sie hier.
        </p>
      </div>
      {
        category.plannedArticles.length > 0 && (
          <>
            <h3>Geplant</h3>
            <ul class="draft-list">
              {category.plannedArticles.map((t) => (
                <li>
                  <span>{t}</span>
                  <span class="badge">In Vorbereitung</span>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="weitere">
    <div class="container">
      <h2 id="weitere">Weitere Themenbereiche</h2>
      <div class="grid">
        {
          others.map((c) => (
            <a class="card card--link" href={`/kategorie/${c.slug}`}>
              <Icon name={c.icon} />
              <h3>{c.title}</h3>
              <p>{c.short}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .cat-head :global(.card__icon) {
    margin-bottom: 1rem;
  }
</style>
