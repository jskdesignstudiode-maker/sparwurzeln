---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ProductBox from '../../components/ProductBox.astro';
import {
  getCategories,
  getPublishedArticles,
  getPublishedProducts,
  effectiveDate,
  formatDate,
  isoDate,
  articlePath,
  type Article,
} from '../../lib/content';
import { site, AMAZON_NOTICE } from '../../data/site';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({ params: { category: article.data.category, slug: article.id }, props: { article } }));
}

interface Props {
  article: Article;
}
const { article } = Astro.props;
const d = article.data;

const [categories, allArticles, productMap] = await Promise.all([
  getCategories(),
  getPublishedArticles(),
  getPublishedProducts(),
]);
const category = categories.find((c) => c.id === d.category)!;
const related = allArticles.filter((a) => a.data.category === d.category && a.id !== article.id).slice(0, 3);
const products = d.products.map((id) => productMap.get(id)).filter((p) => p !== undefined);
const hasAmazon = products.some((p) => p!.data.network === 'amazon');

const { Content } = await render(article);

// Produktboxen an passenden Stellen: HTML des Artikels vor der H2-Überschrift teilen, die auf den gewählten Abschnitt folgt.
const placed = d.productPlacements.filter((pl) => productMap.has(pl.product));
const placedIds = new Set(placed.map((pl) => pl.product));
const unplaced = products.filter((p) => !placedIds.has(p!.id));
type Segment = { html: string; product?: (typeof products)[number] };
const segments: Segment[] = [];
const html = article.rendered?.html ?? '';
if (placed.length > 0 && html) {
  const h2s = [...html.matchAll(/<h2[^>]*>(.*?)<\/h2>/g)].map((m) => ({ text: m[1].replace(/<[^>]+>/g, '').trim(), index: m.index! }));
  const cuts = placed
    .map((pl) => {
      const i = h2s.findIndex((h) => h.text === pl.after);
      if (i < 0) throw new Error(`Produktplatzierung: Abschnitt „${pl.after}“ nicht gefunden`);
      return { pos: i + 1 < h2s.length ? h2s[i + 1].index : html.length, product: productMap.get(pl.product)! };
    })
    .sort((a, b) => a.pos - b.pos);
  let last = 0;
  for (const c of cuts) {
    segments.push({ html: html.slice(last, c.pos), product: c.product });
    last = c.pos;
  }
  segments.push({ html: html.slice(last) });
}
const published = effectiveDate(article);
const url = `${site.url}${articlePath(article)}`;
const abs = (src?: string) => (src ? (src.startsWith('http') ? src : site.url + src) : undefined);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: d.title,
      description: d.description,
      inLanguage: 'de-DE',
      mainEntityOfPage: url,
      datePublished: isoDate(published),
      dateModified: isoDate(d.lastReviewed ?? published),
      ...(d.image ? { image: abs(d.image) } : {}),
      author: { '@type': 'Organization', name: site.name, url: site.url },
      publisher: { '@type': 'Organization', name: site.name, url: site.url },
    },
    ...(d.faq.length > 0
      ? [
          {
            '@type': 'FAQPage',
            mainEntity: d.faq.map((f) => ({
              '@type': 'Question',
              name: f.question,
              acceptedAnswer: { '@type': 'Answer', text: f.answer },
            })),
          },
        ]
      : []),
  ],
};
---

<Base title={d.seoTitle ?? d.title} description={d.description!} jsonLd={jsonLd}>
  <Breadcrumb
    items={[
      { name: 'Startseite', href: '/' },
      { name: category.data.title, href: `/kategorie/${category.id}` },
      { name: d.title },
    ]}
  />

  <article class="container article-head">
    <div class="prose">
      <a class="eyebrow" href={`/kategorie/${category.id}`}>{category.data.title}</a>
      <h1>{d.title}</h1>
      {d.image && <img class="article-image" src={d.image} alt={d.imageAlt ?? ''} decoding="async" />}
    </div>

    {
      products.length > 0 && (
        <div class="prose">
          <p class="ad-note">
            <strong>Anzeige:</strong> Dieser Ratgeber enthält Werbelinks. Mehr dazu im <a href="/affiliate-hinweis">Affiliate-Hinweis</a>.
          </p>
        </div>
      )
    }

    <div class="prose article-body">
      {
        segments.length > 0 ? (
          segments.map((seg) => (
            <>
              <Fragment set:html={seg.html} />
              {seg.product && <ProductBox product={seg.product} />}
            </>
          ))
        ) : (
          <Content />
        )
      }
    </div>

    {
      d.faq.length > 0 && (
        <section class="prose faq" aria-labelledby="faq-titel">
          <h2 id="faq-titel">Häufige Fragen</h2>
          {d.faq.map((f) => (
            <details>
              <summary>{f.question}</summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </section>
      )
    }

    {
      unplaced.map((p) => <div class="prose"><ProductBox product={p!} /></div>)
    }

    {hasAmazon && <p class="prose products__notice">{AMAZON_NOTICE}</p>}

    {
      d.sources.length > 0 && (
        <section class="prose sources" aria-labelledby="quellen-titel">
          <h2 id="quellen-titel">Quellen</h2>
          <ul>
            {d.sources.map((s) => (
              <li>
                <a href={s.url} rel="noopener noreferrer" target="_blank">{s.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>

  {
    related.length > 0 && (
      <section class="section section--tint" aria-labelledby="mehr-titel">
        <div class="container">
          <h2 id="mehr-titel">Mehr zum Thema {category.data.title}</h2>
          <div class="grid">
            {related.map((a) => <ArticleCard article={a} />)}
          </div>
        </div>
      </section>
    )
  }
</Base>
