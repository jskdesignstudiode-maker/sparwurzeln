---
interface Props {
  size?: number;
  withText?: boolean;
}
const { size = 44, withText = true } = Astro.props;
---

<span class="logo">
  <svg
    width={size}
    height={size}
    viewBox="0 0 64 64"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="32" cy="32" r="30" fill="#526747"></circle>
    <path d="M32 34V22" stroke="#F5F2E9" stroke-width="3.5" stroke-linecap="round" fill="none"></path>
    <path d="M32 24c0-7 5-11 12-11 0 7-5 11-12 11Z" fill="#F5F2E9"></path>
    <path d="M32 27c0-5-4-8-9-8 0 5 4 8 9 8Z" fill="#B9956B"></path>
    <path
      d="M32 34c0 6-1 9-7 14M32 34c0 6 1 9 7 14M32 34v14"
      stroke="#B9956B"
      stroke-width="3"
      stroke-linecap="round"
      fill="none"></path>
  </svg>
  {withText && <span class="logo__text">Sparwurzeln</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }
  .logo__text {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.45rem;
    color: var(--ink);
    letter-spacing: 0.01em;
  }
</style>
