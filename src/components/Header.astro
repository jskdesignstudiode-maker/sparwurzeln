---
import Logo from './Logo.astro';
import { getCategories } from '../lib/content';
const categories = await getCategories();
const current = Astro.url.pathname.replace(/\.html$/, '');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Sparwurzeln – zur Startseite">
      <Logo />
    </a>
    <nav aria-label="Hauptnavigation">
      <ul class="nav">
        {
          categories.map((c) => (
            <li>
              <a
                href={`/kategorie/${c.id}`}
                aria-current={current === `/kategorie/${c.id}` ? 'page' : undefined}
              >
                {c.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--cream-light);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 0.9rem;
  }
  .site-header__brand {
    text-decoration: none;
  }
  .nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
  }
  .nav a {
    display: inline-block;
    padding: 0.35rem 0;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border-bottom: 2px solid transparent;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    border-bottom-color: var(--sand);
  }
</style>
