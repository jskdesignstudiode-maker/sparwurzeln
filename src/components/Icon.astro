---
interface Props {
  name: 'coin' | 'sprout' | 'pot' | 'jar' | 'tools';
}
const { name } = Astro.props;
---

<svg
  class="card__icon"
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'coin' && (
    <>
      <circle cx="24" cy="24" r="16" />
      <path d="M29 18.5c-1-1.6-2.8-2.5-5-2.5-3 0-5 1.5-5 3.8 0 5.2 10.5 2.2 10.5 7.6 0 2.4-2.2 4.1-5.500 4.100-2.400 0-4.400-1-5.500-2.700M24 13v3M24 32v3" />
    </>
  )}
  {name === 'sprout' && (
    <>
      <path d="M24 40V24" />
      <path d="M24 26c0-7 5-11 13-11 0 7-5 11-13 11Z" />
      <path d="M24 30c0-5-4-8-10-8 0 5 4 8 10 8Z" />
      <path d="M16 40h16" />
    </>
  )}
  {name === 'pot' && (
    <>
      <path d="M9 22h30l-2 15a4 4 0 0 1-4 3.500H15a4 4 0 0 1-4-3.500L9 22Z" />
      <path d="M6 22h36M18 12c0 3 2 3 2 6M26 10c0 3 2 3 2 6" />
    </>
  )}
  {name === 'jar' && (
    <>
      <rect x="14" y="9" width="20" height="6" rx="2" />
      <path d="M16 15c-3 2-4 4-4 7v14a4 4 0 0 0 4 4h16a4 4 0 0 0 4-4V22c0-3-1-5-4-7" />
      <path d="M12 26h24" />
    </>
  )}
  {name === 'tools' && (
    <>
      <path d="M30 10a8 8 0 0 0-7 11L9 35a3.500 3.500 0 0 0 5 5l14-14a8 8 0 0 0 11-7l-5 4-4-1-1-4 5-4a8 8 0 0 0-4 0Z" />
    </>
  )}
</svg>
