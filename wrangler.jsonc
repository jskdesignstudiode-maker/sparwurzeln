{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sparwurzeln",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Der Worker läuft nur für Seiten (nicht für Bilder und Skripte), damit er im kostenlosen Kontingent bleibt.
    "run_worker_first": ["/*", "!/_astro/*", "!/uploads/*", "!/favicon.svg"]
  }
}
